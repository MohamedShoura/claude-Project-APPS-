# =====================================================================
# Dr. Mohamed Shoura — Portfolio Website Environment Configuration
# ---------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# All NEXT_PUBLIC_* variables are exposed to the browser — only put
# PUBLIC contact information here (no private/personal numbers).
# =====================================================================

# ---- Site ----------------------------------------------------------
# Canonical production URL (used for SEO, sitemap, Open Graph, schema)
NEXT_PUBLIC_SITE_URL=https://mohamedshoura.com

# ---- Public Contact Information ------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=info@mohamedshoura.com
NEXT_PUBLIC_PHONE_UAE=+971-000-000-000
NEXT_PUBLIC_PHONE_QATAR=+974-000-000-000
NEXT_PUBLIC_PHONE_EGYPT=+20-000-000-000

# WhatsApp number in international format WITHOUT the leading "+" or spaces
NEXT_PUBLIC_WHATSAPP=971000000000

# ---- Social Profiles -----------------------------------------------
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/in/mohamedshoura
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/mohamedshoura
NEXT_PUBLIC_YOUTUBE=https://www.youtube.com/@mohamedshoura

# ---- Booking / Lead Form Integration -------------------------------
# The contact & booking forms POST to this endpoint. Leave blank to use
# the built-in mock handler (logs to console + shows success state).
#
# Formspree example:  https://formspree.io/f/xxxxxxxx
# Custom API route:   /api/contact
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional CRM / integration keys (server side — do NOT prefix NEXT_PUBLIC)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
ZOHO_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
