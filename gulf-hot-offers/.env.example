# ---------------------------------------------------------------------------
# Gulf Hot Offers — environment variables
# Copy to `.env.local` and fill in. The DEMO build runs with NONE of these set.
# NEVER commit real secrets. NEVER expose private keys with the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://gulfhotoffers.example

# --- Database (only needed when moving off the demo data layer) ---
DATABASE_URL=postgresql://user:password@localhost:5432/gulfhotoffers

# --- Redis cache / background job queue ---
REDIS_URL=redis://localhost:6379

# --- Search service (Meilisearch / Typesense / Elasticsearch) ---
SEARCH_HOST=http://localhost:7700
SEARCH_API_KEY=

# --- Authentication (NextAuth or similar) ---
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Retailer connectors (server-side ONLY — no NEXT_PUBLIC_ prefix) ---
# Noon affiliate / partner feed
NOON_AFFILIATE_TOKEN=
NOON_PARTNER_ID=
# Amazon Product Advertising API (.ae / .sa)
AMAZON_PA_ACCESS_KEY=
AMAZON_PA_SECRET_KEY=
AMAZON_PA_PARTNER_TAG=
# Snoonu partner feed
SNOONU_API_KEY=

# --- Notifications ---
SENDGRID_API_KEY=
WHATSAPP_API_TOKEN=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# --- Image CDN (Cloudinary / imgix) ---
IMAGE_CDN_URL=

# --- Affiliate tracking ---
AFFILIATE_DEFAULT_UTM_SOURCE=gulfhotoffers
